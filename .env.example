# Приём заявок в Telegram-группу (используется в app/api/lead/route.ts).
# Токен и chat_id держим ТОЛЬКО на сервере — на клиент они не попадают.
#
# 1. Создайте бота у @BotFather и вставьте токен ниже.
# 2. Добавьте бота в группу администратором.
# 3. chat_id группы — отрицательный, вида -100xxxxxxxxxx
#    (узнать можно, отправив сообщение в группу и открыв
#     https://api.telegram.org/bot<TOKEN>/getUpdates).

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# (Необязательно) Общий rate-limit заявок для нескольких инстансов — Upstash Redis.
# Если не заданы — используется in-memory лимит (на один процесс).
# https://upstash.com → создать Redis → скопировать REST URL и токен.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Примечание: на статическом хостинге (GitHub Pages) серверный роут не запускается —
# форма уходит в Telegram через deep-link, эти переменные там не нужны.
